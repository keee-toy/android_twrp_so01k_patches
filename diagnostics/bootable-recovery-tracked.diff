 using android::fs_mgr::FstabEntry;
 using android::fs_mgr::MetadataBuilder;
 
+namespace {
+
+constexpr char kSo01kP435StagePath[] = "/tmp/p435-pre-fstab-stage";
+constexpr uint32_t kSo01kP435StageMagic = 0x50343335U;
+constexpr uint32_t kSo01kP435StageVersion = 1U;
+constexpr uint64_t kSo01kP435StageCheckSeed = 0x534f30314b503435ULL;
+
+struct So01kP435StageRecord {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t stage;
+	uint32_t stage_inverse;
+	uint64_t boottime_ns;
+	uint64_t checksum;
+};
+
+static_assert(sizeof(So01kP435StageRecord) == 32,
+	"P4.35 stage publication must remain fixed-size");
+
+uint64_t so01k_p435_stage_checksum(const So01kP435StageRecord& record) {
+	return kSo01kP435StageCheckSeed ^ record.magic ^
+		(static_cast<uint64_t>(record.version) << 32) ^ record.stage ^
+		(static_cast<uint64_t>(record.stage_inverse) << 32) ^
+		record.boottime_ns;
+}
+
+}  // namespace
+
+void so01k_p435_publish_preui_stage(unsigned stage) {
+	/* All P4.35 call sites execute serially on recovery's startup thread. */
+	static unsigned last_published_stage;
+	if (stage <= last_published_stage || stage > SO01K_P435_GR_INIT_REACHED)
+		return;
+
+	struct timespec timestamp;
+	if (clock_gettime(CLOCK_BOOTTIME, &timestamp) != 0)
+		return;
+
+	So01kP435StageRecord record = {};
+	record.magic = kSo01kP435StageMagic;
+	record.version = kSo01kP435StageVersion;
+	record.stage = stage;
+	record.stage_inverse = ~stage;
+	record.boottime_ns = static_cast<uint64_t>(timestamp.tv_sec) * 1000000000ULL +
+		static_cast<uint64_t>(timestamp.tv_nsec);
+	record.checksum = so01k_p435_stage_checksum(record);
+
+	int fd = open(kSo01kP435StagePath, O_WRONLY | O_CREAT | O_CLOEXEC, 0600);
+	if (fd < 0)
+		return;
+	ssize_t written = pwrite(fd, &record, sizeof(record), 0);
+	close(fd);
+	if (written == static_cast<ssize_t>(sizeof(record)))
+		last_published_stage = stage;
+}
+
